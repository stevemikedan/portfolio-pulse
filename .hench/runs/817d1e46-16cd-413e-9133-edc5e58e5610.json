        "content": "import { StatCards } from \"@/components/StatCards\";\nimport { AssignmentsList } from \"@/components/AssignmentsList\";\nimport { ActivityFeed } from \"@/components/ActivityFeed\";\nimport { GapAnalysis } from \"@/components/GapAnalysis\";\nimport { RhythmChart } from \"@/components/RhythmChart\";\nimport { mockData } from \"@/lib/mock-data\";\n\nexport default function Home() {\n  const { stats, tasks, activity, gaps, rhythm } = mockData;\n\n  return (\n    <div className=\"flex flex-col flex-1 min-h-0\" style={{ background: \"var(--bg)\", color: \"var(--text)\" }}>\n      <header className=\"px-6 py-4 border-b\" style={{ borderColor: \"var(--border)\" }}>\n        <h1 className=\"text-lg font-semibold tracking-tight\">Portfolio Pulse</h1>\n        <p className=\"text-xs\" style={{ color: \"var(--text-3)\" }}>\n          What you should be doing · what you&apos;re doing · where the gaps are\n        </p>\n      </header>\n\n      <main className=\"flex-1 overflow-auto p-6 space-y-6\">\n        {/* Stat cards — full width */}\n        <StatCards {...stats} />\n\n        {/* 2-col grid: assignments + activity */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          <AssignmentsList tasks={tasks} />\n          <ActivityFeed events={activity} />\n        </div>\n\n        {/* 2-col grid: rhythm + gap analysis */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          <RhythmChart data={rhythm} />\n          <GapAnalysis gaps={gaps} />\n        </div>\n      </main>\n    </div>\n  );\n}\n"
